{
	"name": "dataflow1_dinesh",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "AzureSqlTable1",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText1",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "select1"
				},
				{
					"name": "derivedColumn1"
				},
				{
					"name": "surrogateKey1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          claim_id as string,",
				"          patient_id as string,",
				"          claim_amount as double,",
				"          insurance_provider as string,",
				"          claim_status as string,",
				"          hospital_id as string,",
				"          claim_date as timestamp,",
				"          last_updated as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table',",
				"     partitionBy('hash', 1)) ~> source1",
				"source1 select(mapColumn(",
				"          claim_id,",
				"          patient_id,",
				"          claim_amount,",
				"          insurance_prov = insurance_provider,",
				"          claim_status,",
				"          hospital_id,",
				"          claim_date,",
				"          last_updated",
				"     ),",
				"     partitionBy('roundRobin', 2),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 derive(load_date = currentDate()) ~> derivedColumn1",
				"derivedColumn1 keyGenerate(output(seq1 as long),",
				"     startAt: 1L,",
				"     stepValue: 1L) ~> surrogateKey1",
				"surrogateKey1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          custid as string,",
				"          fname as string,",
				"          lname as string,",
				"          age as string,",
				"          profession as string",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}